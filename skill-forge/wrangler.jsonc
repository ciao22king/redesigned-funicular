{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-forge",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  // Solo valori pubblici qui: questo file è versionato su git.
  // GITHUB_ID è il client ID OAuth, visibile a chiunque nell'URL di login.
  // GITHUB_SECRET, NEXTAUTH_SECRET e OPENROUTER_API_KEY sono secret e si
  // impostano con `wrangler secret put` o dalla dashboard, mai in questo file.
  "vars": {
    "GITHUB_ID": "Ov23li3WNZ0SwllP72tP"
  },
  // Non cancellare le variabili impostate dalla dashboard a ogni deploy CLI.
  "keep_vars": true,
  // Contatore delle generazioni giornaliere per utente (3/giorno).
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "eeb827ee94054a5fb7691ce305b001ad"
    }
  ],
  // Marketplace delle skill pubblicate: elenco, stelle, ricerca.
  "d1_databases": [
    {
      "binding": "MARKETPLACE",
      "database_name": "skill-forge-marketplace",
      "database_id": "8d40d0e8-7f54-442c-b55a-6e6285e37fba",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
