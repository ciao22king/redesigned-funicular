{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-forge",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  // Public values only here: this file is versioned on git.
  // GITHUB_ID is the OAuth client ID, visible to anyone in the login URL.
  // GITHUB_SECRET, NEXTAUTH_SECRET and OPENROUTER_API_KEY are secrets and are
  // set with `wrangler secret put` or from the dashboard, never in this file.
  "vars": {
    "GITHUB_ID": "Ov23li3WNZ0SwllP72tP",
    // Logins exempt from the daily limit, comma-separated. The owner has no
    // quota; the others stay at DAILY_LIMIT generations per day.
    "UNLIMITED_LOGINS": "ciao22king"
  },
  // Do not clear the variables set from the dashboard on every CLI deploy.
  "keep_vars": true,
  // Daily generation counter per user (3/day).
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "eeb827ee94054a5fb7691ce305b001ad"
    }
  ],
  // Marketplace of the published skills: list, stars, search.
  "d1_databases": [
    {
      "binding": "MARKETPLACE",
      "database_name": "skill-forge-marketplace",
      "database_id": "8d40d0e8-7f54-442c-b55a-6e6285e37fba",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // "none": by default Cloudflare redirects /file.html to /file, and Google
    // wants the verification file at the exact path. Next pages are generated
    // on the fly, not served as .html from this folder.
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
