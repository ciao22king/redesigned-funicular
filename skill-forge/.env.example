# ---- GitHub OAuth (login) ----
# Crea una OAuth App su https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# (in produzione: https://<tuo-worker>.<sottodominio>.workers.dev/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=

# ---- NextAuth ----
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Token Harbor (AI) ----
# Base URL OpenAI-compatibile
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
# La tua Universal Key, formato thk_live_...
TOKENHARBOR_API_KEY=
# Modello da usare
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
