# ---- GitHub OAuth (login) ----
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# (in production: https://<your-worker>.<subdomain>.workers.dev/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- OpenRouter (AI) ----
# OpenAI-compatible gateway with the free models
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter key, format sk-or-v1-...
OPENROUTER_API_KEY=
# List of free models in order of power (from strongest to weakest).
# If a model fails, the generation moves on to the next one.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,recursive/flint-v1.0:free,google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,liquid/lfm-2.5-2.6b:free

# ---- Public site URL (for metadata, sitemap, robots) ----
NEXT_PUBLIC_SITE_URL=https://skillforge.cc.cd

# Cloudflare Web Analytics site token for skillforge.cc.cd (public, safe in the
# client bundle). This is the site *token* from the site's snippet, not the site
# tag. Leave empty to disable the beacon.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
