# ---- GitHub OAuth (login) ----
# Crea una OAuth App su https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# (in produzione: https://<tuo-worker>.<sottodominio>.workers.dev/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=

# ---- NextAuth ----
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- OpenRouter (AI) ----
# Gateway OpenAI-compatibile con i modelli free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chiave OpenRouter, formato sk-or-v1-...
OPENROUTER_API_KEY=
# Lista di modelli free in ordine di potenza (dal più forte al più debole).
# Se un modello fallisce, la generazione passa al successivo.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,recursive/flint-v1.0:free,google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free,cohere/north-mini-code:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,liquid/lfm-2.5-2.6b:free

# ---- URL pubblico del sito (per metadata, sitemap, robots) ----
NEXT_PUBLIC_SITE_URL=https://skillforge.eu.org
