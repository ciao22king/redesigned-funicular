# ---- GitHub OAuth (login) ----
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# (in production: https://<your-worker>.<subdomain>.workers.dev/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- LLM providers (AI) ----
# Both speak the OpenAI protocol. The ladder tries Groq first, then OpenRouter.
# A provider with no key is simply skipped, so one key is enough. Set both and a
# Groq outage still answers through OpenRouter.
#
# Groq: https://console.groq.com/keys , key format gsk_...
GROQ_API_KEY=
# Optional: comma-separated model ids. Defaults to the built-in Groq ladder.
GROQ_MODELS=
# Optional: reasoning_effort for the Groq models that support it.
GROQ_REASONING_EFFORT=

# OpenRouter: https://openrouter.ai/keys , key format sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional: comma-separated model ids, fastest first. Defaults to the built-in
# OpenRouter ladder. The list below is the old order; leave it unset to use the
# tuned default in src/lib/providers.ts.
OPENROUTER_MODELS=
# Optional: reasoning effort for OpenRouter (none|low|medium|high). Default medium.
OPENROUTER_REASONING_EFFORT=

# ---- Public site URL (for metadata, sitemap, robots) ----
NEXT_PUBLIC_SITE_URL=https://skillforge.cc.cd

# Cloudflare Web Analytics site token for skillforge.cc.cd (public, safe in the
# client bundle). This is the site *token* from the site's snippet, not the site
# tag. Leave empty to disable the beacon.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
