{
  "name": "skill-forge-cli",
  "version": "0.1.0",
  "description": "CLI per Skill Forge: genera, pubblica e scarica skill per agenti AI dal terminale.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skill-forge": "dist/index.js",
    "sf": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
